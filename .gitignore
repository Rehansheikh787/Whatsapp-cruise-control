# =============================================================================
# WHATSAPP CRUISE CONTROL - PRIVACY & SECURITY GITIGNORE
# Prevents leaking personal chats, phone numbers, auth sessions, and API keys.
# =============================================================================

# 1. WhatsApp Authentication & Session Credentials (CRITICAL: Account Access)
auth_info_baileys/
*auth_info*
baileys_auth_info/
*.session

# 2. Raw Personal WhatsApp Chats & Transcripts
WhatsApp Chats/
WhatsApp\ Chats/
*.txt
!requirements.txt
*Chat with*

# 3. Processed Datasets & Chat Exports
data/
*.jsonl

# 4. Personal Contact Maps & Phone Numbers
config/relationship_map.json
config/contact_relationship_map.json
# (Use config/relationship_map.json.example as the public template)

# 5. Runtime Logs & Decision Audits (Contains real messages & numbers)
logs/
*.log

# 6. Chroma Vector Database & Embeddings Storage
chroma_data/
.chroma_server.pid

# 7. Environment Variables & Secret API Keys
.env
.env.*
!*.example
*.env
*.local

# 8. Python Virtual Environments & Packages
.venv/
venv/
env/
ENV/
Lib/
share/
*.exe
*.dll
*.bin
*.so

# 9. Node Modules & Logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 10. Python Cache & Test Artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# 11. OS & IDE Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/

# 12. Local Course Reference Documents
*.docx
*.pdf
